{
  "name": "jiraia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "infra/local",
    "infra/layers"
  ],
  "engines": {
    "node": ">=24.18.0",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "aws:bootstrap": "bun run infra/aws/bootstrap.ts",
    "build": "bun run web:build && bun run infra/build/package.ts",
    "build:layer": "bun run infra/layers/build.ts",
    "check": "bunx biome check",
    "check:audit": "bun run infra/ci/audit-gate.ts",
    "check:config": "bun run infra/ci/config-gate.ts",
    "check:contracts": "bun run infra/ci/contracts-gate.ts",
    "check:fix": "bunx biome check --write",
    "check:handlers": "bun run infra/ci/handlers-gate.ts",
    "check:http": "bun run infra/ci/http-gate.ts",
    "check:licenses": "bun run infra/ci/licenses-gate.ts",
    "check:prose": "bun run infra/ci/prose-gate.ts",
    "check:timezone": "bun run infra/ci/timezone-gate.ts",
    "check:zod": "bun run infra/ci/zod-gate.ts",
    "contracts": "bun run infra/contracts/openapi.ts",
    "db:generate": "drizzle-kit generate --config services/work/drizzle.config.ts",
    "db:migrate": "bun run infra/local/migrate.ts",
    "import:atlassian": "bun run infra/import/atlassian.ts",
    "local:digest": "bun run infra/local/digest.ts",
    "local:email-preview": "bun run infra/local/email-preview.ts",
    "local:github": "bun run infra/local/github-send.ts",
    "local:down": "docker compose down",
    "local:reset": "docker compose down -v && docker compose up -d --wait && bun run infra/local/migrate.ts && bun run infra/local/seed.ts",
    "local:serve": "bun run infra/local/server.ts",
    "local:up": "docker compose up -d --wait",
    "prepare": "bunx husky",
    "seed": "bun run infra/local/seed.ts",
    "test": "bun test packages services infra",
    "test:all": "bun run test && bun run web:test",
    "test:ci": "bun run check && bunx tsc --noEmit && bun run test && bun run build && bun run check:handlers && bun run check:config && bun run check:timezone && bun run check:zod && bun run check:http && bun run check:prose && bun run check:contracts && bun run check:licenses",
    "test:integration": "docker compose up -d --wait && bun test $(find packages services infra -name '*.integration.test.ts' -not -path '*/node_modules/*')",
    "test:unit": "bun test $(find packages services infra -name '*.unit.test.ts' -not -path '*/node_modules/*')",
    "typecheck": "bunx tsc --noEmit",
    "up": "bun run infra/local/up.ts",
    "web:build": "bun run --filter @jiraia/web build",
    "web:dev": "bun run --filter @jiraia/web dev",
    "web:e2e": "bun run --filter @jiraia/web e2e",
    "web:test": "bun run --filter @jiraia/web test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/aws-lambda": "8.10.164",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "msw": "3.0.3",
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
